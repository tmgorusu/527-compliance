	<xsd:annotation>
		<xsd:documentation>
			<Description>IRS 887x Schema - Base types commonly used across schema files</Description>
			<Version>Version 2.3</Version>
			<ReleaseDate>October 7, 2005</ReleaseDate>
		</xsd:documentation>
	</xsd:annotation>
	<!-- attributes -->
	<xsd:attributeGroup name="pacInfo">
		<xsd:attribute name="pacId" type="xsd:positiveInteger" use="optional"/>
		<xsd:attribute name="ein" type="xsd:positiveInteger" use="optional"/>
	</xsd:attributeGroup>
	<!-- String Type -->
	<xsd:simpleType name="StringType">
		<xsd:annotation>
			<xsd:documentation>Base type for a string.  Does not allow pipe, greater than and less than characters and leading white space. Updated (9/2009) to not allow characters > 127 (i.e. non-ascii) by only allowing whitespace and printable ascii: exclaimation (33) through tilde (126).</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[^\s][^\|&lt;&gt;][\s!&#34;#&#36;%&amp;'\(\)\*\+,\-\./:;=\?@\[\\\]\^_`\{\}~a-zA-Z0-9]*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- Date Type -->
	<xsd:simpleType name="DateType">
		<xsd:annotation>
			<xsd:documentation>Dates must be represented as a Gregorian calendar date with CCYY-MM-DD lexical representation.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date"/>
	</xsd:simpleType>
	<!-- Month Type -->
	<xsd:simpleType name="MonthType">
		<xsd:annotation>
			<xsd:documentation>A two digit month type</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date">
			<xsd:pattern value="[0-1][0-9]"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- Year Type in the format of YYYY-->
	<xsd:simpleType name="YearType">
		<xsd:annotation>
			<xsd:documentation>Base type for a 4-digit year</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:gYear"/>
	</xsd:simpleType>
	<!-- Boolean Type - true or false, or 1 or 0 -->
	<xsd:simpleType name="BooleanType">
		<xsd:annotation>
			<xsd:documentation>Base type for a boolean. Typically used on an Yes or No field.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:boolean"/>
	</xsd:simpleType>
	<!-- Checkbox Type String -->
	<xsd:simpleType name="CheckboxTypeString">
		<xsd:annotation>
			<xsd:documentation>Typically used by an optional checkbox.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:length value="1"/>
			<xsd:pattern value="0|1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- Checkbox Type String -->
	<xsd:simpleType name="CheckboxTypeYes">
		<xsd:annotation>
			<xsd:documentation>Typically used by an optional checkbox.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:length value="1"/>
			<xsd:pattern value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- U.S. Amount Type -->
	<xsd:simpleType name="USAmountType">
		<xsd:annotation>
			<xsd:documentation>Type for a U.S. integer amount field.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:integer">
			<xsd:totalDigits value="19"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- EAIN Type -->
	<xsd:simpleType name="EAINType">
		<xsd:annotation>
			<xsd:documentation>Type for Election Authority Identification No. - 30 Characters.  Same limitations as the StringType. </xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="StringType"/> 
	</xsd:simpleType>
	<!-- Street Address Type -->
	<xsd:simpleType name="StreetAddressType">
		<xsd:annotation>
			<xsd:documentation>Used for street address.  Invalid characters are: _ @ $ ^ &amp; ( ) + = | \ [ ] { } * &gt; &lt; " ' : ~ ; ? ! and leading space.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="35"/>
			<xsd:pattern value="[^\s_@$\^&amp;\(\)\+=\|\\\[\]\{\}\*&gt;&lt;&apos;&quot;:;\?!][A-Za-z0-9\.\-#%/,\s]+"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- Street Address, optional second line Type -->
	<xsd:simpleType name="StreetAddressLineTwoType">
		<xsd:annotation>
			<xsd:documentation>Used for street address.  Invalid characters are: _ @ $ ^ &amp; ( ) + = | \ [ ] { } * &gt; &lt; " ' : ~ ; ? ! and leading space.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="35"/>
			<xsd:pattern value="[^\s_@$\^&amp;\(\)\+=\|\\\[\]\{\}\*&gt;&lt;&apos;&quot;:;\?!][A-Za-z0-9\.\-#%/,\s]*"/>
		</xsd:restriction>
	</xsd:simpleType>

	<!-- City Type -->
	<xsd:simpleType name="CityType">
		<xsd:annotation>
			<xsd:documentation>Used for a city.  Invalid characters are: _ @ $ ^ &amp; ( ) + = | \ [ ] { } * &gt; &lt; " ' : ~ ; ? ! and leading space.</xsd:documentation>
